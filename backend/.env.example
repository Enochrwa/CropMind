# ─── App ────────────────────────────────────────────────
APP_NAME=CropMind
APP_ENV=development
APP_VERSION=1.0.0
SECRET_KEY=change-me-to-a-random-64-char-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ─── Database ───────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://cropmind:password@localhost:5432/cropmind
SYNC_DATABASE_URL=postgresql://cropmind:password@localhost:5432/cropmind

# ─── Redis ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── Ollama (local LLM) ─────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:7b-instruct-q4_K_M

# ─── Whisper ────────────────────────────────────────────
WHISPER_MODEL=small
WHISPER_DEVICE=cpu

# ─── ML Model ───────────────────────────────────────────
ONNX_MODEL_PATH=app/ml/models/cropmind_v1.onnx
TFLITE_MODEL_PATH=app/ml/models/cropmind_v1.tflite
CONFIDENCE_THRESHOLD=0.65

# ─── Storage (S3-compatible) ────────────────────────────
S3_BUCKET=cropmind-uploads
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── Balance / Payments ─────────────────────────────────
DIAGNOSIS_COST_RWF=600
VOICE_COST_PER_MINUTE_RWF=50
MIN_TOPUP_RWF=500
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Translation ────────────────────────────────────────
TRANSLATION_MODEL_DIR=app/ml/translation_models

# ─── Rate limiting ──────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ─── CORS ───────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
